  "version": "2.0.0",
  "description": "MCP server for OLX.uz: profile, my adverts & stats, competitor and market analysis",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "olx-mcp-server": "dist/index.js"
  },
  "scripts": {
